{
    "name": "spamacom/laravel-html",
    "description": "HTML and Form Builders for the Laravel Framework | Upgraded by Mouhammad Alali",
    "license": "MIT",
    "homepage": "https://github.com/spamacom/laravel-html",
    "support": {
        "issues": "https://github.com/spamacom/laravel-html/issues",
        "source": "https://github.com/spamacom/laravel-html"
    },
    "authors": [
        {
            "name": "Mouhammad Alali",
            "email": "mouhammad.alali@gmail.com"
        },
        {
            "name": "Adam Engebretson",
            "email": "adam@laravelcollective.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/http": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "illuminate/database": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Collective\\Html\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Collective\\Html\\HtmlServiceProvider"
            ],
            "aliases": {
                "Form": "Collective\\Html\\FormFacade",
                "Html": "Collective\\Html\\HtmlFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
